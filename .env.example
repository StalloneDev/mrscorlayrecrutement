# Neon PostgreSQL Database URL
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secret session key (HMAC SHA-256)
SESSION_SECRET="your-secure-random-secret-key-min-32-chars"

# Public App URL
NEXT_PUBLIC_APP_URL="https://mrscorlayrecrutement.vercel.app"

# SMTP Office 365 / Microsoft Exchange Configuration
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER="recrutement@yourdomain.com"
SMTP_PASS="your-password-or-app-password"
SMTP_FROM="\"Direction des Ressources Humianes MRS & CORLAY Recrutement\" <recrutement@yourdomain.com>"

# Vercel Blob Storage Token (facultatif si stockage hybride base64 actif)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
